# Copy to .env and fill in. Never commit the real .env.

# --- Instance config ---
N8N_HOST=gateway.baalebo.xyz
GENERIC_TIMEZONE=Africa/Lagos
N8N_ENCRYPTION_KEY=            # generate: openssl rand -hex 24

# --- Cloudflare Tunnel token ---
# Get this from Cloudflare Zero Trust dashboard when you create the
# tunnel -- see the walkthrough for exact steps.
TUNNEL_TOKEN=

# --- Gateway auth ---
GATEWAY_API_KEY=

# --- Free-tier providers (skip any you don't have) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GITHUB_TOKEN=
SAMBANOVA_API_KEY=
HF_API_KEY=
